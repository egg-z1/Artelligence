POSTGRES_DB=artelligence
POSTGRES_USER=artelligence
POSTGRES_PASSWORD=artelligence
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/artelligence
DB_USERNAME=artelligence
DB_PASSWORD=artelligence
SERVER_PORT=8081
# Optional for local GET API work; required to use POST /api/v1/generate.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Same read/write account configured for the existing Blob APIs; the configured container must already exist.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=generated-images
