# 애플리케이션 설정
APP_NAME=Artelligence
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=DEBUG

# Azure OpenAI 설정
AZURE_OPENAI_ENDPOINT=https://artelligencedevopenai.openai.azure.com/
# az keyvault secret show --vault-name artelligence-dev-kv --name openai-api-key --query value -o tsv
AZURE_OPENAI_API_KEY=<위 명령어 결과값>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-image-1-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Blob Storage 설정
AZURE_STORAGE_ACCOUNT_NAME=artelligencedevsa
AZURE_STORAGE_ACCOUNT_KEY=
#az keyvault secret show --vault-name artelligence-dev-kv --name storage-connection-string --query value -o tsv
AZURE_STORAGE_CONNECTION_STRING=<위 명령어 결과값>
AZURE_STORAGE_CONTAINER_NAME=generated-images

# Azure Key Vault 설정 (선택사항)
AZURE_KEY_VAULT_URL=https://artelligence-dev-kv.vault.azure.net/
USE_KEY_VAULT=false

# 이미지 생성 설정
DEFAULT_IMAGE_SIZE=1024x1024
DEFAULT_IMAGE_QUALITY=standard
DEFAULT_IMAGE_STYLE=vivid
MAX_PROMPT_LENGTH=4000

# 타임아웃 설정 (초)
IMAGE_GENERATION_TIMEOUT=120
STORAGE_UPLOAD_TIMEOUT=60